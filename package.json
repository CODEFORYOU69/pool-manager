{
  "name": "taekwondo-tournament-manager",
  "version": "1.2.0",
  "description": "Application de gestion de compétitions de taekwondo",
  "homepage": "./",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "react-scripts build && concurrently \"npm run start\" \"cross-env BROWSER=none npm run react-start\"",
    "react-start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "postinstall": "cd api && npm install",
    "predist": "npm run build",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.1.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.2",
    "papaparse": "^5.4.1",
    "prisma": "^6.5.0",
    "react": "^18.2.0",
    "react-brackets": "^0.4.7",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "react-scripts": "5.0.1",
    "uuid": "^9.0.1"
  },
  "build": {
    "appId": "com.taekwondo.tournament-manager",
    "productName": "Taekwondo Tournament Manager",
    "extends": null,
    "files": [
      "build/**/*",
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "api",
        "to": "api",
        "filter": [
          "**/*",
          "!node_modules/.cache/**",
          "!.env",
          "!prisma/dev.db",
          "!prisma/dev.db-journal"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.sports",
      "icon": "build-resources/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build-resources/entitlements.mac.plist",
      "entitlementsInherit": "build-resources/entitlements.mac.plist",
      "identity": null,
      "notarize": false
    },
    "afterPack": "scripts/afterPack.js",
    "afterSign": "scripts/notarize.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build-resources/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Sports"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asar": true,
    "asarUnpack": [
      "api/**"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
